# Postgres connection string (added automatically by Vercel's Neon integration)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel Blob token (added automatically when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# "private" (recommended) or "public" - must match how your Blob store was created
BLOB_ACCESS=private

# Random secret used to sign login sessions (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Sign-up is open until the first account exists, then closes automatically.
# Set to "true" to let anyone create an account.
ALLOW_SIGNUP=false

# Maximum upload size in MB
MAX_UPLOAD_MB=100
